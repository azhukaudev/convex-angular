{
  "name": "@convex-angular/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev:frontend": "nx serve frontend",
    "dev:backend": "convex dev",
    "build:frontend": "nx build frontend",
    "build:library": "nx build convex-angular",
    "dev:docs": "nx serve docs",
    "build:docs": "nx build docs",
    "check:docs": "nx check docs",
    "test:library": "nx test convex-angular",
    "test:mutation": "stryker run",
    "check:duplication": "jscpd packages/convex-angular/src packages/convex-angular/testing/src packages/convex-angular/better-auth/src apps/frontend/src",
    "check:deadcode": "knip",
    "typecheck": "tsc --noEmit -p packages/convex-angular/tsconfig.typecheck.json",
    "typecheck:spec": "tsc --noEmit -p packages/convex-angular/tsconfig.spec.json",
    "lint": "nx run-many -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:quick": "pnpm run typecheck && pnpm run lint && pnpm run check:duplication && pnpm run check:deadcode",
    "verify:ci": "pnpm run format:check && pnpm run typecheck && nx run-many -t lint,test,build && pnpm run check:duplication && pnpm run check:deadcode",
    "verify:full": "pnpm run format:check && pnpm run typecheck && nx run-many -t lint,test,build && pnpm run check:duplication && pnpm run check:deadcode && pnpm run test:mutation",
    "prepare": "lefthook install",
    "update": "nx migrate latest"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@convex-dev/better-auth": "0.13.0",
    "@fontsource/roboto": "5.2.10",
    "better-auth": "1.7.17",
    "convex": "1.49.0",
    "material-symbols": "0.45.7",
    "rxjs": "7.8.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.5",
    "@angular-devkit/core": "22.2.5",
    "@angular-devkit/schematics": "22.2.5",
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@nx/angular": "23.3.1",
    "@nx/eslint": "23.3.1",
    "@nx/eslint-plugin": "23.3.1",
    "@nx/jest": "23.3.1",
    "@nx/js": "23.3.1",
    "@nx/web": "23.3.1",
    "@nx/workspace": "23.3.1",
    "@schematics/angular": "22.2.5",
    "@stryker-mutator/api": "9.6.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.41",
    "@swc/helpers": "0.5.23",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.1",
    "@typescript-eslint/utils": "8.61.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-preset-angular": "17.0.3",
    "jscpd": "5.0.6",
    "jsdom": "27.4.0",
    "jsonc-eslint-parser": "3.1.0",
    "knip": "6.16.1",
    "lefthook": "2.1.9",
    "ng-packagr": "22.2.5",
    "nx": "23.3.1",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "0.14.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0"
  },
  "nx": {
    "includedScripts": []
  }
}
