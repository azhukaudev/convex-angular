{
  "name": "@convex-angular/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for convex-angular, built with Astro Starlight",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && ngc -p tsconfig.examples.json --noEmit && node scripts/check-examples-referenced.mjs && ! grep -rnE \"\\['_(args|returnType)'\\]\" src/content"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "@astrojs/vercel": "11.0.5",
    "astro": "7.2.2",
    "starlight-links-validator": "0.25.3"
  },
  "devDependencies": {
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@astrojs/check": "0.9.10",
    "@types/jest": "30.0.0",
    "convex": "1.45.0",
    "rxjs": "7.8.2",
    "typescript": "6.0.3"
  }
}
