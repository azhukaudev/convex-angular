{
  "name": "@convex-angular/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for convex-angular, built with Astro Starlight",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "check": "astro check && ngc -p tsconfig.examples.json --noEmit && node scripts/check-examples-referenced.mjs && node scripts/check-error-quotes.mjs && ! grep -rnE \"\\['_(args|returnType)'\\]\" src/content"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.5",
    "@astrojs/starlight": "0.42.8",
    "astro": "7.4.5",
    "starlight-links-validator": "0.27.0"
  },
  "devDependencies": {
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@astrojs/check": "0.9.12",
    "@types/jest": "30.0.0",
    "convex": "1.49.0",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
